# =============================================================================
# Training Configuration
# Modify parameters here instead of editing train.py
# =============================================================================

# --- Epochs & Early Stop ---
EPOCHS=200
EARLY_STOP_PATIENCE=15
MIN_DELTA=0.001

# --- Learning Rate & Scheduler ---
LEARNING_RATE=0.0001
SCHEDULER=plateau              # none | plateau | cosine
PLATEAU_MODE=max               # max (for dice) | min (for loss)
PLATEAU_PATIENCE=5
COSINE_TMAX=50

# --- Model ---
N_CHANNELS=1                   # 1 for grayscale
NUM_CLASSES=1                  # 1 = binary segmentation
BILINEAR=false

# --- Optimizer ---
OPTIMIZER=adamw                # adam | adamw | rmsprop | sgd
WEIGHT_DECAY=0.00001
MOMENTUM=0.9
GRADIENT_CLIP=1.0
AMP=true                       # mixed precision

# --- Batch Size ---
# Per-GPU batch size, total batch = BATCH_SIZE_PER_GPU × num_GPUs
BATCH_SIZE_PER_GPU=20

# --- GPU Selection ---
# Auto-select idle GPUs (free memory > threshold)
GPU_MEM_FREE_GB=10

# --- Dataset & Transfer Learning ---
DATASET=phantom_1              # phantom_1 | dataset1 | mixed | phantom_2
VAL_DATASET=phantom_1          # comma-separated, first is primary (determines checkpoint/early-stop)
FREEZE_ENCODER=false
UNFREEZE_EPOCH=10
UNFREEZE_LAYERS=down3,down4

# --- Checkpoint ---
CHECKPOINT_DIR=outputs/checkpoints
RESUME_PATH=
RUN_NAME=run

# --- WandB (optional, set WANDB_ENABLE=true and fill in your entity to use) ---
WANDB_ENABLE=false
WANDB_ENTITY=                  # your wandb username or team name
WANDB_PROJECT_NAME=us-segmentation
LOG_HISTOGRAMS=false
