# =============================================================================
# Training Configuration
# 修改这里的参数，不需要动 train.py
# =============================================================================

# --- Epochs & Early Stop ---
EPOCHS=200
EARLY_STOP_PATIENCE=30         # 必须 >> PLATEAU_PATIENCE，否则降LR还没起效就停了
# MIN_DELTA 必须是 0。
# 上一次跑：PRIMARY 在 20 个 epoch 里的总波动范围只有 0.005，而 MIN_DELTA=0.001 占了
# 其中的 20%。更糟的是静脉在 PRIMARY 里的有效权重只有 0.15（musv 0.3 × 静脉占其一半），
# 所以静脉单独要涨 0.001/0.15 = 0.0067（0.67 个点）才算一次"改进"——而它的 epoch 间
# 噪声是 ±0.02。早停实际上是在噪声上触发的：epoch 7 存了 checkpoint，然后 20 轮没动，
# 停在 27。用 patience 控制耐心就够了，不需要再加一个门槛。
MIN_DELTA=0

# --- Learning Rate & Scheduler ---
LEARNING_RATE=0.0003            # 从零训练用 3e-4（与之前 Exp-A/B/C 一致）
SCHEDULER=plateau              # none | plateau | cosine
PLATEAU_MODE=max               # max (for dice) | min (for loss)
PLATEAU_PATIENCE=5             # 5个epoch无提升就把LR减半（20/5 = 最多降4次）
COSINE_TMAX=50

# --- Model ---
N_CHANNELS=1                   # 1 for grayscale
NUM_CLASSES=3                  # 3 = 背景 / 静脉 / 动脉 (部分标签 marginal loss)
                               # 1 = 旧的二分类模型
BILINEAR=false
# CE_CLASS_WEIGHTS=1,3,3       # 别开。静脉的漏检像素上 p1 中位数 = 0.0019、p0 = 0.946，
                               # 模型不是"犹豫了一下选背景"，是"确信是背景"。类别权重
                               # 只能挪决策边界，这里没有可挪的东西。

# --- 容量 / 正则（v3 的主变量）---
# 【为什么】静脉在过拟合，而且是**对那 80 个受试者**过拟合：
#     musv 静脉 聚合Dice:  train 0.931  /  val 0.726     ← 差 0.20
#     musv 动脉:           val 0.90，没有这个差距
# 模型在训练过的数据上把静脉看得清清楚楚，换一批人就丢掉五分之一。而它有的是本钱去背：
# musv 的 2203 帧只来自 80 个 sweep = 80 根静脉，默认宽度是 31M 参数 —— 每根静脉 39 万个参数。
#
# 动脉逃过一劫，是因为它每次都长一个样（圆的、暗的、压不扁），80 个样本就够覆盖。
# 静脉会形变（被探头压扁的方式因人而异），80 个样本盖不住，多出来的容量就拿去背了。
#
# 【为什么不是增强的问题】在线增强先试过了，val 静脉纹丝不动（train_loss 0.074→0.096，
# 说明像素级记忆确实被打破了，但 val 根本不在乎）。gamma 和旋转能造出同样 80 个人的
# 无数种外观，但**造不出第 81 个人**。
#
#   base_ch=64 -> 31.0M 参数（原版）      base_ch=32 -> 7.8M      base_ch=16 -> 1.9M
BASE_CH=32
DROPOUT=0.3                    # Dropout2d，只加在最深的两个 encoder 块和 bottleneck

# --- Optimizer ---
OPTIMIZER=adamw                # adam | adamw | rmsprop | sgd
WEIGHT_DECAY=0.001             # 1e-4 -> 1e-3：和 BASE_CH/DROPOUT 一起打过拟合
MOMENTUM=0.9
GRADIENT_CLIP=0.5
AMP=true                       # mixed precision (faster on H100)

# --- Batch Size ---
# 这里是每张 GPU 的 batch size，总 batch = BATCH_SIZE_PER_GPU × GPU数量
BATCH_SIZE_PER_GPU=16

# --- DataLoader ---
# 增强现在是训练时在线做的（不再烤进 NPZ），worker 要干真活，得够多才喂得饱 GPU。
NUM_WORKERS=8

# --- GPU Selection ---
# 自动选择空闲 GPU（utilization < 阈值 且 空闲显存 > 阈值）
GPU_UTIL_THRESHOLD=20          # GPU 利用率低于此值视为空闲 (%)
GPU_MEM_FREE_GB=10             # 空闲显存大于此值才选用 (GB)

# --- Dataset ---
# 用 '+' 连接即训练并集。每个数据集自带 label_mode，loss 会把每个样本路由到
# 对应的监督模式（见 train.py: partial_label_loss）：
#   musv                -> full3   背景/静脉/动脉，全标注
#   phantom_taobao      -> vessel  只知道哪里是血管，不知道动/静脉
#   customer_3d_phantom -> vessel  同上
#   mendeley            -> artery  只标了动脉，颈内静脉没标（不会被当成背景惩罚）
DATASET=musv+phantom_taobao+mendeley+customer_3d_phantom
# 每个 epoch 在这些数据集上验证，全部打印。
# 一项里用 '+' 连接 = 池化成一个指标（按样本数加权）。
# 两个 phantom 都是二分类、都是实机实验用的东西，所以合成一个 "仿体" 指标：
#   phantom_taobao(13 张) + customer_3d_phantom(4 张) = 17 张
# 分开算没意义 —— customer_3d 只有 4 张图，单独的 Dice 全是噪声。
# 注意：只有 label_mode 相同的数据集才能池化（否则会报错），因为把 artery Dice
# 和 vessel Dice 平均成一个数是没有物理意义的。
VAL_DATASET=musv,phantom_taobao+customer_3d_phantom,mendeley

# 用哪个分数决定 checkpoint / early-stop / LR 调度。
#   weighted   = 各验证集按 VAL_WEIGHTS 加权求和（推荐）
#   mean       = 各验证集等权
#   <数据集名>  = 只用那一个
PRIMARY_VAL=weighted
# 各验证集按权重加权求和，决定存哪一版 checkpoint。
#
# 【为什么从 0.6/0.3/0.1 改成 0.45/0.45/0.10】
# 权重压在一个不会动的指标上，等于把准则的那一份直接作废。上一次跑的实测：
#   仿体 vessel:  0.9302 → 0.9355 → 0.9310 → … → 0.9298   从 epoch 2 起就平了
# 二十多个 epoch 波动不到 0.006。它拿着 0.6 的权重，却贡献不了任何区分度——真正有余量
# 的只有 musv（0.3），而静脉又只占 musv 分数的一半，于是静脉在整个准则里的有效权重只有
# 0.15。结果就是：准则挑不出"静脉更好"的那一版。
#
# 注意：给饱和的指标加权重并不能"保护"它——保护来自它不下跌，而不是来自它的权重。
# 0.45 已经足够在仿体真的退步时否决一个 checkpoint。
#
#   仿体 0.45   —— 真机实验跑的就是它。已饱和在 0.93，权重的作用是"别退步"
#   Mus-V 0.45  —— 动静脉分离能力全靠它，也是唯一还有余量的。分数 = (静脉+动脉)/2
#                  → 静脉的有效权重 0.45 × 0.5 = 0.225（原来是 0.15）
#   mendeley 0.10 —— 现在用 dice_artery（不再是 dice_vessel，见下）
#
# 【mendeley 那一项之前是反的】它原本落到 dice_vessel，而 mendeley 只标了动脉，
# 所以模型每正确找到一根没标注的颈内静脉都被扣分。实测：mendeley dice_artery 全程平在
# 0.95，dice_vessel 却从 0.751 一路爬到 0.894 —— 唯一的机制就是静脉预测在死掉。同期
# musv 静脉从 0.614 掉到 0.574。这一项是在花 0.1 的权重买"把静脉杀掉"。
# 已在 train.py: evaluate_metrics / primary_score 里修掉：artery 模式只报 dice_artery。
#
# 名字必须和 VAL_DATASET 里的写法完全一致（含 '+'）。权重不必和为 1，会自动归一化。
VAL_WEIGHTS=phantom_taobao+customer_3d_phantom:0.45, musv:0.45, mendeley:0.10
FREEZE_ENCODER=false
UNFREEZE_EPOCH=10
UNFREEZE_LAYERS=down3,down4

# --- GPU ---
MAX_GPUS=1                     # H200 一次只占一张卡；多卡 DataParallel 会让 val loss 变 NaN

# --- Checkpoint ---
CHECKPOINT_DIR=models/unet/checkpoints   # 每个架构自带 checkpoints/
RESUME_PATH=                   # 从零训练
RESET_BEST_DICE=false
RUN_NAME=mixav_v3_cap32        # v3: 砍容量 31M->7.8M + dropout0.3 + wd 1e-3，专打静脉过拟合

# --- WandB ---
WANDB_ENABLE=true
WANDB_ENTITY=worldangle
WANDB_PROJECT_NAME=us-segmentation
LOG_HISTOGRAMS=false
