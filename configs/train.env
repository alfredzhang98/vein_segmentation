# 通用 U-Net 混合训练模板，不绑定数据集新增任务或 checkpoint 版本。
# 优先级：--set KEY=VALUE > shell 环境变量 > 此文件 > 代码默认值。
# --config 指定本文件时不合并根 .env。先用 --show-config 检查生效参数。
# python models/unet/train.py --config configs/train.env --show-config
RUN_NAME=mixed_unet
CHECKPOINT_DIR=models/unet/checkpoints

# 从零训练：INIT_PATH / RESUME_PATH 都留空。
# 微调：只设置 INIT_PATH；同时按实验需求覆盖 LEARNING_RATE / EPOCHS。
# 续训：只设置 RESUME_PATH；优化器、学习率和进度由 checkpoint 恢复。
INIT_PATH=
RESUME_PATH=
RESET_BEST_DICE=false

# 训练集用 + 组合；验证集用逗号分组，组内 + 表示合并评估。
# 每个数据集仍由 DATASET_CONFIGS 定义 label_mode，保留部分标签混合 loss。
# PMC 标注完成后可追加 pmc9883282，并调整验证分组/权重。
DATASET=musv+phantom_taobao+mendeley+customer_3d_phantom
# 每张训练原图每轮随机增强抽样次数；留空沿用各域 aug_times_train。
# 可按实验覆盖，如 TRAIN_REPEATS=pmc9883282:50；必须已在 DATASET 中选择该域。
# 只改变训练采样比例，不重建 NPZ、不改变 label_mode 或验证/测试集。
TRAIN_REPEATS=
VAL_DATASET=musv,phantom_taobao+customer_3d_phantom,mendeley
PRIMARY_VAL=weighted
VAL_WEIGHTS=musv:0.45,phantom_taobao+customer_3d_phantom:0.45,mendeley:0.10

N_CHANNELS=1
NUM_CLASSES=3
BASE_CH=32
DROPOUT=0.3
BILINEAR=false
FREEZE_ENCODER=false
TVERSKY_BETA=0
TVERSKY_ALPHA=0
CE_CLASS_WEIGHTS=

LEARNING_RATE=0.0003
WEIGHT_DECAY=0.001
OPTIMIZER=adamw
GRADIENT_CLIP=1.0
SCHEDULER=plateau
PLATEAU_MODE=max
PLATEAU_PATIENCE=5
EPOCHS=200
EARLY_STOP_PATIENCE=30
MIN_DELTA=0.001

AMP=true
BATCH_SIZE_PER_GPU=16
NUM_WORKERS=8
MAX_GPUS=1
LOG_TRAIN_GAP=true
WANDB_ENABLE=false
LOG_HISTOGRAMS=false
